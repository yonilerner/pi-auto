{
  "name": "pi-auto",
  "version": "0.2.0",
  "description": "Minimal automatic tool review and sandboxed execution for the pi coding agent.",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc --project tsconfig.test.json --noEmit",
    "ci": "npm run typecheck && npm run typecheck:test && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:sandbox": "PI_AUTO_SANDBOX_TESTS=1 vitest run tests/sandbox-native.test.ts",
    "test:live": "PI_AUTO_LIVE_TESTS=1 vitest run tests/live/reviewer-scenarios.test.ts",
    "bench:reviewer": "npm run test:live --"
  },
  "pi": {
    "extensions": [
      "./extensions/pi-auto.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-coding-agent": "^1.2.0",
    "typebox": "^1.2.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@foxfirecodes/sandbox-runtime": "0.0.55-foxfirecodes.4"
  }
}
